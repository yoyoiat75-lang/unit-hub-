local function sld(page, label, desc, minV, maxV, def, cb)
    local SLD_H = IS_MOBILE and sp(72) or sp(64)
    local row = Instance.new("Frame", page)
    row.Size             = UDim2.new(1, 0, 0, SLD_H)
    row.BackgroundColor3 = W.surface
    row.BorderSizePixel  = 0
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 9)
    Instance.new("UIStroke", row).Color        = W.sep

    local ll = Instance.new("TextLabel", row)
    ll.Size                  = UDim2.new(0.62, 0, 0, sp(18))
    ll.Position              = UDim2.new(0, sp(13), 0, sp(9))
    ll.BackgroundTransparency = 1
    ll.Text                  = label
    ll.TextColor3            = W.txtPri
    ll.Font                  = Enum.Font.GothamSemibold
    ll.TextSize              = IS_MOBILE and 11 or 12
    ll.TextXAlignment        = Enum.TextXAlignment.Left

    local vl = Instance.new("TextLabel", row)
    vl.Size                  = UDim2.new(0.34, 0, 0, sp(18))
    vl.Position              = UDim2.new(0.64, 0, 0, sp(9))
    vl.BackgroundTransparency = 1
    vl.Text                  = tostring(def)
    vl.TextColor3            = W.accent
    vl.Font                  = Enum.Font.GothamBold
    vl.TextSize              = IS_MOBILE and 11 or 12
    vl.TextXAlignment        = Enum.TextXAlignment.Right

    if desc ~= "" then
        local dl = Instance.new("TextLabel", row)
        dl.Size                  = UDim2.new(1, -sp(26), 0, sp(13))
        dl.Position              = UDim2.new(0, sp(13), 0, sp(27))
        dl.BackgroundTransparency = 1
        dl.Text                  = desc
        dl.TextColor3            = W.txtHint
        dl.Font                  = Enum.Font.Gotham
        dl.TextSize              = IS_MOBILE and 8 or 9
        dl.TextXAlignment        = Enum.TextXAlignment.Left
    end

    local trk = Instance.new("Frame", row)
    trk.Size             = UDim2.new(1, -sp(26), 0, IS_MOBILE and 7 or 5)
    trk.Position         = UDim2.new(0, sp(13), 1, -sp(15))
    trk.BackgroundColor3 = W.sep
    trk.BorderSizePixel  = 0
    Instance.new("UICorner", trk).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", trk)
    fill.Size             = UDim2.new((def - minV) / (maxV - minV), 0, 1, 0)
    fill.BackgroundColor3 = W.accent
    fill.BorderSizePixel  = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    Instance.new("UIGradient", fill).Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, W.accent),
        ColorSequenceKeypoint.new(1, W.accentPurp)
    }

    local DOT_S = IS_MOBILE and 18 or 14
    local dot = Instance.new("Frame", trk)
    dot.Size              = UDim2.new(0, DOT_S, 0, DOT_S)
    dot.AnchorPoint       = Vector2.new(0.5, 0.5)
    dot.Position          = UDim2.new((def - minV) / (maxV - minV), 0, 0.5, 0)
    dot.BackgroundColor3  = Color3.new(1, 1, 1)
    dot.BorderSizePixel   = 0
    dot.ZIndex            = 3
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
    local dotS = Instance.new("UIStroke", dot); dotS.Color = W.accent; dotS.Thickness = 1.5

    local dragging = false
    local HIT_PAD  = IS_MOBILE and 24 or 14

    local hb = Instance.new("TextButton", trk)
    hb.Size                  = UDim2.new(1, 0, 0, HIT_PAD * 2)
    hb.Position              = UDim2.new(0, 0, 0.5, -HIT_PAD)
    hb.BackgroundTransparency = 1
    hb.Text                  = ""
    hb.ZIndex                = 10

    local function upd(mx)
        local t = math.clamp((mx - trk.AbsolutePosition.X) / trk.AbsoluteSize.X, 0, 1)
        local v = math.floor(minV + t * (maxV - minV))
        fill.Size     = UDim2.new(t, 0, 1, 0)
        dot.Position  = UDim2.new(t, 0, 0.5, 0)
        vl.Text       = tostring(v)
        cb(v)
    end

    hb.MouseButton1Down:Connect(function()
        dragging = true
        tw(dot, 0.1, { Size = UDim2.new(0, DOT_S + 4, 0, DOT_S + 4) })
    end)

    -- Fixed: use InputEnded on UIS for reliable mouse/touch release
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                tw(dot, 0.1, { Size = UDim2.new(0, DOT_S, 0, DOT_S) })
            end
        end
    end)

    RS.Heartbeat:Connect(function()
        if not dragging then return end
        local pos
        if IS_MOBILE then
            local touches = UIS:GetTouchState()
            if #touches > 0 then pos = touches[1].Position end
        end
        pos = pos or UIS:GetMouseLocation()
        if pos then upd(pos.X) end
    end)

    hb.MouseButton1Click:Connect(function() upd(UIS:GetMouseLocation().X) end)
end

