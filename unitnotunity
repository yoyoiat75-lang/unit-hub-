local function showAlert(label, dist, col)
    local r = math.floor(col.R*255); local g = math.floor(col.G*255); local b = math.floor(col.B*255)
    local function dk(v, f) return math.max(0, math.floor(v*f)) end

    AlertBanner.BackgroundColor3 = Color3.fromRGB(dk(r,0.34), dk(g,0.18), dk(b,0.18))
    ABGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(dk(r,0.52), dk(g,0.26), dk(b,0.26))),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(dk(r,0.36), dk(g,0.16), dk(b,0.16))),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(dk(r,0.20), dk(g,0.09), dk(b,0.09))),
    }
    AStroke.Color = col; AAccent.BackgroundColor3 = col
    AIconBg.BackgroundColor3 = Color3.fromRGB(dk(r,0.55), dk(g,0.28), dk(b,0.28))
    AIconBgStroke.Color = col

    -- Distance bar: full = danger (close), empty = safe (far)
    local frac = math.clamp(1 - dist / ALERT_RANGE, 0.05, 1)
    ADistFill.Size = UDim2.new(frac, 0, 1, 0)
    ADistFill.BackgroundColor3 = col

    ATitle.Text = label .. " NEARBY"; ATitle.TextColor3 = Color3.new(1,1,1)
    ASub.Text   = "Image entity  ·  " .. math.floor(dist) .. " studs away"
    ASub.TextColor3 = Color3.fromRGB(math.min(255,dk(r,0.9)+140), math.min(255,dk(g,0.5)+80), math.min(255,dk(b,0.5)+80))

    if not alertShowing then
        alertShowing = true; AlertBanner.Visible = true
        AlertBanner.Position = UDim2.new(0.5, 0, -0.24, 0)
        tw(AlertBanner, 0.26, { Position = UDim2.new(0.5, 0, 0, 16) })
    end
    task.spawn(function()
        for _ = 1, 3 do
            tw(AStroke, 0.12, { Transparency = 0.85 }); task.wait(0.18)
            tw(AStroke, 0.12, { Transparency = 0 });    task.wait(0.18)
        end
    end)
    if alertHideTask then task.cancel(alertHideTask) end
    alertHideTask = task.delay(6.0, hideAlert)
end

