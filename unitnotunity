        if not F.ImageAlert then ivImgEnt.Text = "alerts off"; ivImgEnt.TextColor3 = W.txtHint; continue end
        local hrp = getHRP(); if not hrp then continue end
        local selfPos = hrp.Position
        local nearestDist, nearestEntry = math.huge, nil
        for model, data in pairs(entityCache) do
            local entry = matchImageEntity(model.Name)
            if entry and data.pp then
                local dist = (selfPos - data.pp.Position).Magnitude
                if dist < nearestDist then nearestDist = dist; nearestEntry = entry end
                if dist <= ALERT_RANGE then
                    local now = tick()
                    if now - (imageEntityAlerted[entry.pattern] or 0) > 8 then
                        imageEntityAlerted[entry.pattern] = now
                        showAlert(entry.label, dist, entry.color)
                        notify("⚠ " .. entry.label .. "  " .. math.floor(dist) .. " studs", entry.color)
                    end
                end
            end
        end
        if nearestEntry then
            ivImgEnt.Text      = nearestEntry.label .. "  " .. math.floor(nearestDist) .. " st"
            ivImgEnt.TextColor3 = nearestDist <= ALERT_RANGE and W.danger or W.warn
        else
            ivImgEnt.Text       = "none detected"
            ivImgEnt.TextColor3 = W.txtSec
        end
    end
end)

-- ── Player ESP loop ────────────────────────────────────────────────
-- Mode behaviour:
--   highlight = green fill/outline highlight only (no label)
--   chams     = green wall-through chams only (no label)
--   both      = highlight + chams + name/dist/HP billboard label
local function cleanPlayerESP(char)
    if not char then return end
    for _, tag in ipairs({ "P_ESP", "P_CHAMS", "P_BILL" }) do
        local obj = char:FindFirstChild(tag); if obj then obj:Destroy() end
    end
end

task.spawn(function()
    while task.wait(0.6) do
        for _, p in ipairs(PLR:GetPlayers()) do
            if p == LP then continue end
            local char = p.Character; if not char then continue end

            -- If PlayerESP is off, wipe everything and move on
            if not F.PlayerESP then
                cleanPlayerESP(char)
                continue
            end

            local mode     = F.PlayerESPMode
            local wantHL   = (mode == "highlight" or mode == "both")
            local wantChams= (mode == "chams"     or mode == "both")
            local wantBill = (mode == "chams"     or mode == "both")  -- label on chams + both

            -- ── Highlight (green fill, no label) ──
            local existHL = char:FindFirstChild("P_ESP")
            if wantHL and not existHL then
                local h = Instance.new("Highlight", char); h.Name = "P_ESP"
                h.FillColor        = Color3.fromRGB(0, 200, 80)
                h.OutlineColor     = Color3.fromRGB(0, 255, 110)
                h.FillTransparency = 0.40
                task.spawn(function()
                    while char and char:FindFirstChild("P_ESP")
                          and F.PlayerESP
                          and (F.PlayerESPMode == "highlight" or F.PlayerESPMode == "both") do
                        task.wait(0.5)
                    end
                    pcall(function() local e = char:FindFirstChild("P_ESP"); if e then e:Destroy() end end)
                end)
            elseif not wantHL and existHL then
                existHL:Destroy()
