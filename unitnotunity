    ll.Position              = UDim2.new(0, sp(14), 0, sp(10))
    ll.BackgroundTransparency = 1
    ll.Text                  = label
    ll.TextColor3            = broken and W.warn or W.txtPri
    ll.Font                  = Enum.Font.GothamSemibold
    ll.TextSize              = IS_MOBILE and 11 or 12
    ll.TextXAlignment        = Enum.TextXAlignment.Left
    ll.ZIndex                = 2

    local dl = Instance.new("TextLabel", row)
    dl.Size                  = UDim2.new(1, -sp(72), 0, sp(15))
    dl.Position              = UDim2.new(0, sp(14), 0, sp(31))
    dl.BackgroundTransparency = 1
    dl.Text                  = desc
    dl.TextColor3            = W.txtHint
    dl.Font                  = Enum.Font.Gotham
    dl.TextSize              = IS_MOBILE and 9 or 10
    dl.TextXAlignment        = Enum.TextXAlignment.Left
    dl.ZIndex                = 2

    local PILL_W = IS_MOBILE and sp(46) or sp(40)
    local PILL_H = IS_MOBILE and sp(26) or sp(22)
    local track = Instance.new("Frame", row)
    track.Size             = UDim2.new(0, PILL_W, 0, PILL_H)
    track.Position         = UDim2.new(1, -PILL_W - sp(13), 0.5, -PILL_H / 2)
    track.BackgroundColor3 = W.pillOff
    track.BorderSizePixel  = 0
    track.ZIndex           = 3
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    local trkS = Instance.new("UIStroke", track); trkS.Color = Color3.fromRGB(80, 80, 110); trkS.Thickness = 1

    local THUMB = IS_MOBILE and sp(20) or sp(16)
    local thumb = Instance.new("Frame", track)
    thumb.Size             = UDim2.new(0, THUMB, 0, THUMB)
    thumb.Position         = UDim2.new(0, 3, 0.5, -THUMB / 2)
    thumb.BackgroundColor3 = Color3.fromRGB(168, 168, 194)
    thumb.BorderSizePixel  = 0
    thumb.ZIndex           = 4
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)

    local active     = false
    local THUMB_ON_X = PILL_W - THUMB - 3

    local function setState(v)
        active = v
        if v then
            tw(track,   0.16, { BackgroundColor3 = W.accent })
            tw(trkS,    0.16, { Color = W.accentHov })
            tw(thumb,   0.16, { Position = UDim2.new(0, THUMB_ON_X, 0.5, -THUMB / 2), BackgroundColor3 = Color3.new(1, 1, 1) })
            tw(rs,      0.16, { Color = W.accent })
            tw(row,     0.16, { BackgroundColor3 = Color3.fromRGB(10, 14, 38) })
            tw(leftBar, 0.16, { BackgroundTransparency = 0 })
        else
            tw(track,   0.16, { BackgroundColor3 = W.pillOff })
            tw(trkS,    0.16, { Color = Color3.fromRGB(80, 80, 110) })
            tw(thumb,   0.16, { Position = UDim2.new(0, 3, 0.5, -THUMB / 2), BackgroundColor3 = Color3.fromRGB(168, 168, 194) })
            tw(rs,      0.16, { Color = W.sep })
            tw(row,     0.16, { BackgroundColor3 = isAlt and W.surfaceAlt or W.surface })
            tw(leftBar, 0.16, { BackgroundTransparency = 1 })
        end
    end

    local hb = Instance.new("TextButton", row)
    -- Larger hit area on mobile
    local HIT_EXTRA = IS_MOBILE and sp(6) or 0
    hb.Size                  = UDim2.new(1, 0, 1, HIT_EXTRA)
    hb.Position              = UDim2.new(0, 0, 0, -HIT_EXTRA / 2)
    hb.BackgroundTransparency = 1
    hb.Text                  = ""
    hb.ZIndex                = 10
    hb.MouseEnter:Connect(function() tw(hov, 0.1, { BackgroundTransparency = 0.94, BackgroundColor3 = Color3.new(1, 1, 1) }) end)
    hb.MouseLeave:Connect(function() tw(hov, 0.1, { BackgroundTransparency = 1 }) end)
    hb.MouseButton1Click:Connect(function() setState(not active); cb(active) end)
    return setState
end

