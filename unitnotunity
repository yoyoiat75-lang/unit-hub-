--                     IMPROVED PATHFINDING v6.0
-- ═══════════════════════════════════════════════════════════════════

local pfActive  = false
local pfThread  = nil
local pfState   = "SCRAP"

-- Speeds
local WALK_SPEED    = 16
local SPRINT_SPEED  = 24
local FLEE_SPEED    = 28

-- Stamina system
local STAMINA_MAX       = 14
local STAMINA_DRAIN     = 1.0
local STAMINA_REGEN     = 0.9
local STAMINA_REGEN_FAST = 2.2
local stamina           = STAMINA_MAX
local lastStaminaTick   = tick()

local function updateStamina(isSprinting, entityFar)
    local now = tick(); local dt = now - lastStaminaTick; lastStaminaTick = now
    if isSprinting then
        stamina = math.max(0, stamina - STAMINA_DRAIN * dt)
    else
        stamina = math.min(STAMINA_MAX, stamina + (entityFar and STAMINA_REGEN_FAST or STAMINA_REGEN) * dt)
    end
    return stamina
end

-- Thresholds
local FLEE_TRIGGER     = 20
local SPRINT_TRIGGER   = 42
local PATH_BLOCK       = 14
local COMBAT_FLEE_TIME = 5.5
local FLEE_DIST        = 58

-- Waypoint navigation tuning
local JUMP_HEIGHT_MIN = 1.6
local STUCK_TIME      = 0.65
local STUCK_DIST      = 1.0
local ARRIVE_RADIUS   = 2.0  -- studs to count as "arrived"
local WP_TIMEOUT      = 6.0

-- PF bookkeeping
local visitedScraps = {}
local lastHP        = math.huge
local ivPFStatus, ivPFSprint

-- Helper: nearest entity
local function nearestEntity(fromPos)
    local bestPos, bestDist = nil, math.huge
    for _, data in pairs(entityCache) do
        if data.pp and data.pp.Parent then
            local d = (fromPos - data.pp.Position).Magnitude
            if d < bestDist then bestDist = d; bestPos = data.pp.Position end
        end
    end
    return bestPos, bestDist
end

local function entityNear(pos, radius)
    for _, data in pairs(entityCache) do
        if data.pp and data.pp.Parent then
            if (pos - data.pp.Position).Magnitude < radius then return true end
        end
    end
    return false
end

-- Agent params with fallback costs
local PF_AGENT_PARAMS = {
    AgentHeight  = 5,
    AgentRadius  = 2.2,
    AgentCanJump = true,
    WaypointSpacing = 2,
    Costs = { InteriorInvWall = 1000, Water = 500 },
}

-- Compute a path; returns waypoints or nil
local function computePath(from, to)
    local path = PFS:CreatePath(PF_AGENT_PARAMS)
    local ok = pcall(function() path:ComputeAsync(from, to) end)
    if not ok or path.Status ~= Enum.PathStatus.Success then return nil end
    local wps = path:GetWaypoints()
    return (#wps > 0) and wps or nil
end

-- Walk to a single waypoint with jump, stuck-detection and arrival check
local function walkToWaypoint(hum, wp)
    local hrp = getHRP(); if not hrp then return false end

    local heightDiff = wp.Position.Y - hrp.Position.Y
    if heightDiff > JUMP_HEIGHT_MIN or wp.Action == Enum.PathWaypointAction.Jump then
        hum.Jump = true
        task.wait(0.1)
    end

    hum:MoveTo(wp.Position)

    local lastPos    = hrp.Position
    local lastMoveAt = tick()
    local arrived    = false
    local jumpsSent  = 0

    local conn = hum.MoveToFinished:Connect(function(r)
        arrived = r
    end)

    local t0 = tick()
    repeat
        task.wait(0.05)
        hrp = getHRP()
        if not hrp then conn:Disconnect(); return false end

        local distToWP = (hrp.Position - wp.Position).Magnitude
        if distToWP < ARRIVE_RADIUS then arrived = true; break end

        -- Stuck detection: if we haven't moved enough, jump
        local moved = (hrp.Position - lastPos).Magnitude
        if moved > STUCK_DIST then
            lastPos = hrp.Position; lastMoveAt = tick(); jumpsSent = 0
        elseif tick() - lastMoveAt > STUCK_TIME and jumpsSent < 3 then
            hum.Jump = true
            jumpsSent += 1
            lastMoveAt = tick()
            lastPos    = hrp.Position
        end

        if not pfActive or not F.PathfindScrap then
            conn:Disconnect(); return false
        end
    until arrived or (tick() - t0 > WP_TIMEOUT)

    conn:Disconnect()
    return arrived
end

-- Find best scrap (closest, not visited, not entity-blocked)
local function findBestScrap(fromPos, avoidEntityRadius)
    local best, bestDist, bestPos = nil, math.huge, nil
    for obj in pairs(scrapCache) do
        if visitedScraps[obj] then continue end
        if not obj.Parent then continue end
        local pos
        if obj:IsA("BasePart") then
            pos = obj.Position
        elseif obj:IsA("Model") and obj.PrimaryPart then
            pos = obj.PrimaryPart.Position
        end
        if not pos then continue end
        if avoidEntityRadius and entityNear(pos, avoidEntityRadius) then continue end
        local d = (fromPos - pos).Magnitude
        if d < bestDist then bestDist = d; best = obj; bestPos = pos end
    end
    if best then return { obj = best, pos = bestPos, dist = bestDist } end
    return nil
end

-- Find nearest safe spawn (prefers spawns far from entities)
local function getNearestSafeSpawn(fromPos)
    local parts = getSpawnParts()
    if #parts == 0 then return nil end
    local best, bestScore = nil, -math.huge
    for _, sp in ipairs(parts) do
        local dist   = (fromPos - sp.Position).Magnitude
        local _, eDist = nearestEntity(sp.Position)
        -- Score: farther from entities = better; closer to player = better
        local score  = (eDist or 999) * 0.6 - dist * 0.2
        if score > bestScore then bestScore = score; best = sp end
    end
    return best
end

-- Raw flee: move away from entity centroid for `duration` seconds
local function rawFlee(hum, duration, speed)
    hum.WalkSpeed = speed or FLEE_SPEED
    local t0 = tick()
    while tick() - t0 < duration do
        local hrp = getHRP()
        if not hrp or not hum then break end
        local tx, tz, n = 0, 0, 0
        for _, data in pairs(entityCache) do
            if data.pp and data.pp.Parent then
                local d = (hrp.Position - data.pp.Position).Magnitude
                if d < FLEE_TRIGGER * 5 then tx += data.pp.Position.X; tz += data.pp.Position.Z; n += 1 end
            end
        end
        if n == 0 then break end
        local threat = Vector3.new(tx / n, hrp.Position.Y, tz / n)
        local away   = hrp.Position - threat
        away = Vector3.new(away.X, 0, away.Z)
        if away.Magnitude < 0.5 then away = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) end
        hum:MoveTo(hrp.Position + away.Unit * FLEE_DIST)
        task.wait(0.25)
    end
    local hrp = getHRP()
    if hrp and hum then hum:MoveTo(hrp.Position) end
end

-- Smart flee: pathfind to nearest safe spawn, fall back to rawFlee
local function smartFlee(hum, reason)
    if ivPFStatus then ivPFStatus.Text = "⚠ " .. (reason or "FLEE") .. " → spawn" end
    if ivPFSprint  then ivPFSprint.Text = "COMBAT" end
    hum.WalkSpeed = FLEE_SPEED
    local hrp = getHRP(); if not hrp then return end
    local spawn = getNearestSafeSpawn(hrp.Position)
    if not spawn then rawFlee(hum, COMBAT_FLEE_TIME, FLEE_SPEED); return end

    local waypoints = computePath(hrp.Position, spawn.Position + Vector3.new(0, 3, 0))
    if not waypoints then
        if ivPFStatus then ivPFStatus.Text = "⚠ No path to spawn" end
        rawFlee(hum, COMBAT_FLEE_TIME, FLEE_SPEED)
        return
    end

    local deadline = tick() + COMBAT_FLEE_TIME + 4
    for _, wp in ipairs(waypoints) do
        if tick() > deadline then break end
        if not pfActive or not F.PathfindScrap then break end
        hrp = getHRP(); hum = getHum()
        if not hrp or not hum then break end
        local _, eDist = nearestEntity(hrp.Position)
        hum.WalkSpeed = eDist < SPRINT_TRIGGER and FLEE_SPEED or SPRINT_SPEED
        walkToWaypoint(hum, wp)
    end

    if ivPFStatus then ivPFStatus.Text = "reached safety…" end
    if ivPFSprint  then ivPFSprint.Text = "—" end
    task.wait(0.6)
end

local function stopPathfinding(reason)
    pfActive = false
    if pfThread then pcall(function() task.cancel(pfThread) end); pfThread = nil end
    local hum = getHum()
    if hum then hum.WalkSpeed = F.OrigSpeed * F.SpeedMult end
    if ivPFStatus then ivPFStatus.Text = reason or "idle" end
    if ivPFSprint  then ivPFSprint.Text = "—" end
end

-- ── Main pathfinding loop ──────────────────────────────────────────
local function runPathfindingLoop()
    pfActive        = true
    visitedScraps   = {}
    pfState         = "SCRAP"
    lastStaminaTick = tick()
    lastHP          = (getHum() and math.floor(getHum().Health)) or math.huge

    while F.PathfindScrap and pfActive do
        local hrp = getHRP()
        local hum = getHum()
        if not hrp or not hum then stopPathfinding("no char"); return end

        local selfPos = hrp.Position
        local _, eDist = nearestEntity(selfPos)

        -- Damage check
        local curHP = math.floor(hum.Health)
        if curHP < lastHP and curHP > 0 then
            pfState = "COMBAT"
            stamina = math.min(stamina + 4, STAMINA_MAX)
        end
        lastHP = curHP

        if pfState == "COMBAT" then
            if ivPFStatus then ivPFStatus.Text = "⚠ DAMAGE — fleeing!" end
            smartFlee(hum, "DAMAGE")
            pfState = "SCRAP"
            lastHP  = math.floor((getHum() or { Health = math.huge }).Health)
            continue
        end

        if eDist < FLEE_TRIGGER then
            pfState = "FLEE"
            if ivPFStatus then ivPFStatus.Text = "⚠ Entity " .. math.floor(eDist) .. " st — FLEE" end
            smartFlee(hum, "ENTITY " .. math.floor(eDist) .. " st")
            pfState = "SCRAP"
            continue
        end

        pfState = "SCRAP"

        -- Find target scrap
        local target = findBestScrap(selfPos, PATH_BLOCK)
        if not target then
            visitedScraps = {}
            target = findBestScrap(selfPos, nil)
        end
        if not target then
            if ivPFStatus then ivPFStatus.Text = "no scrap found — waiting" end
            task.wait(2.0); continue
        end

        visitedScraps[target.obj] = true
        if ivPFStatus then ivPFStatus.Text = "→ scrap  " .. math.floor(target.dist) .. " st" end

        local waypoints = computePath(selfPos, target.pos)
        if not waypoints then
            if ivPFStatus then ivPFStatus.Text = "no path — skipping" end
            task.wait(0.8); continue
        end

        local aborted    = false
        local cdownActive = true

        -- Stamina display task
        task.spawn(function()
            while cdownActive and pfActive and F.PathfindScrap do
                if ivPFSprint then
                    ivPFSprint.Text = "stamina  " .. string.format("%.1f", math.floor(stamina * 10) / 10) .. "s"
                end
                task.wait(0.12)
            end
            if ivPFSprint then ivPFSprint.Text = "—" end
        end)

        local lastRecompute = tick()

        for i, wp in ipairs(waypoints) do
            if not F.PathfindScrap or not pfActive then aborted = true; break end

            hrp = getHRP(); hum = getHum()
            if not hrp or not hum then aborted = true; break end

            -- Mid-path damage check
            local midHP = math.floor(hum.Health)
            if midHP < lastHP and midHP > 0 then
                lastHP  = midHP
                pfState = "COMBAT"
                stamina = math.min(stamina + 4, STAMINA_MAX)
                hum:MoveTo(hrp.Position)
                cdownActive = false
                smartFlee(hum, "DAMAGE MID-PATH")
                pfState = "SCRAP"
                lastHP  = math.floor((getHum() or { Health = math.huge }).Health)
                aborted = true; break
            end
            lastHP = midHP

            -- Mid-path entity check
            local _, midEDist = nearestEntity(hrp.Position)
            if midEDist < FLEE_TRIGGER then
                hum:MoveTo(hrp.Position)
                cdownActive = false
                smartFlee(hum, "ENTITY MID-PATH")
                aborted = true; break
            end

            -- Skip waypoints occupied by entities
            if entityNear(wp.Position, PATH_BLOCK) then
                if ivPFStatus then ivPFStatus.Text = "entity on WP — recomputing" end
                -- Attempt path recompute every 2 seconds max
                if tick() - lastRecompute > 2 then
                    lastRecompute = tick()
                    local newWPs = computePath(hrp.Position, target.pos)
                    if newWPs then
                        waypoints = newWPs
                        -- Restart inner loop with new waypoints
                        aborted = true
                        cdownActive = false
                        -- Re-queue same target (don't mark visited)
                        visitedScraps[target.obj] = nil
                    end
                end
                break
            end

            -- Speed based on stamina and entity proximity
            local isSprinting = (midEDist < SPRINT_TRIGGER and stamina > 0.5)
            hum.WalkSpeed = isSprinting and SPRINT_SPEED or WALK_SPEED
            updateStamina(isSprinting, midEDist > SPRINT_TRIGGER * 2)

            walkToWaypoint(hum, wp)
        end

        cdownActive = false
        hum = getHum()
        if hum then hum.WalkSpeed = F.OrigSpeed * F.SpeedMult end
        if not aborted then task.wait(0.2) end
    end

    stopPathfinding("stopped")
end

